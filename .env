# ==============================================================================
# ORVÉLIA — ENTERPRISE E-COMMERCE PLATFORM (.env & .env.local)
# Architect & Lead Developer: Nathan Zoua (NZ)
# SÉCURITÉ : Aucune clé API en dur dans le code. Insérez vos clés Notch Pay ici.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONNEMENT
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="ORVÉLIA"
NEXT_PUBLIC_ARCHITECT_SIGNATURE="Nathan Zoua (NZ)"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
NEXT_PUBLIC_SUPPORTED_LOCALES="fr,en,ar"
NEXT_PUBLIC_DEFAULT_CURRENCY="XAF"
PAYMENT_ACTIVE_PROVIDER="NOTCHPAY"

# ------------------------------------------------------------------------------
# 2. PASSERELLE PRINCIPALE : NOTCH PAY CAMEROUN (À REMPLIR PAR VOS SOINS CÔTÉ BACKEND)
# ------------------------------------------------------------------------------
# 1. Clé Publique Notch Pay (pk_test.... ou pk_live....)
NOTCHPAY_PUBLIC_KEY=""

# 2. Clé Privée / Secrète Notch Pay (sk_test.... ou sk_live.... — STRICTEMENT SERVEUR)
NOTCHPAY_SECRET_KEY=""

# 3. Clé de Hachage Webhook Notch Pay (hsk_test.... ou hsk_live.... — HMAC SHA-256)
NOTCHPAY_WEBHOOK_HASH=""

NOTCHPAY_API_BASE_URL="https://api.notchpay.co"

# ------------------------------------------------------------------------------
# 3. BASE DE DONNÉES POSTGRESQL & PRISMA
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://orvelia_user:CHANGE_ME_PASSWORD@localhost:5432/orvelia_db?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://orvelia_user:CHANGE_ME_PASSWORD@localhost:5432/orvelia_db?schema=public"

# ------------------------------------------------------------------------------
# 4. AUTHENTIFICATION & SÉCURITÉ (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
AUTH_SECRET=""
SESSION_MAX_AGE_SECONDS="2592000"
CSRF_PROTECTION_ENABLED="true"
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE="60"

# ------------------------------------------------------------------------------
# 5. ADAPTATEURS SECONDAIRES OPTIONNELS (CINETPAY, CAMPAY, FLUTTERWAVE)
# ------------------------------------------------------------------------------
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""

CAMPAY_PERMANENT_TOKEN=""

FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
FLW_ENCRYPTION_KEY=""
FLW_WEBHOOK_SECRET_HASH=""

# ------------------------------------------------------------------------------
# 6. CONNECTEUR HYBRIDE SHOPIFY & SERVICES MÉDIAS / EMAILS
# ------------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN="orvelia-dev.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2026-01"

CLOUDINARY_CLOUD_NAME="orvelia-luxury"
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="conciergerie@orvelia.luxury"
